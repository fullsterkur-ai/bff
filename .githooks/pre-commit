#!/usr/bin/env bash
set -euo pipefail

# Get staged .ts, .tsx, .js, or .jsx files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [[ -z "$STAGED_FILES" ]]; then
  echo "No code files staged, skipping checks."
  exit 0
fi

echo "Running format check..."
pnpm format:check

echo "Running TypeScript check..."
pnpm tsc

echo "Running ESLint"
pnpm lint:check